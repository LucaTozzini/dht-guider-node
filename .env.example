# Copy to .env to override defaults. Every setting is optional.

# UDP port for the DHT node.
GN_PORT=6881

# Where the catalogue (catalogue.db) and saved DHT state live.
GN_DATA_DIR=data

# JSON-lines crawl logs, one file per day.
GN_LOG_DIR=logs
# fatal | error | warn | info | debug | trace
GN_LOG_LEVEL=info
# Human-readable terminal output (defaults to true in a terminal).
# GN_LOG_PRETTY=true

# Random DHT lookup interval (ms) to keep NAT mappings open. 0 = off.
GN_KEEPALIVE_MS=30000
# Max DHT queries in flight, shared by lookups, sampling and keepalive.
GN_DHT_CONCURRENCY=128

# Metadata fetching.
GN_FETCH_CONCURRENCY=30
GN_FETCH_MAX_QUEUED=2000
GN_PEERS_PER_HASH=4
GN_FETCH_TIMEOUT_MS=10000
GN_LOOKUP_TIMEOUT_MS=10000

# Comma-separated words; torrents whose name contains any of them (whole
# word, any case) are fetched but not saved. Empty = save everything.
# GN_CATALOGUE_BLOCKLIST=XXX

# BEP 51 sample_infohashes queries per second.
GN_SAMPLER_QPS=10

# How often to log a stats line (ms).
GN_STATS_INTERVAL_MS=60000
